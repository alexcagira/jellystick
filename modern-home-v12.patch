+								)
+							}
+						}
+					}
+				}
+
+				if (content.tracks.isNotEmpty()) {
+					item(key = "tracks_title") {
+						SectionHeader(
+							stringResource(if (content.kind == MusicItemKind.ARTIST) R.string.music_popular_songs else R.string.music_songs),
+							compact = true,
