+	fun isFavorite(song: BaseItemDto) = favorites[song.id] ?: (song.userData?.isFavorite == true)
+	fun toggleFavorite(song: BaseItemDto) {
+		val favorite = !isFavorite(song)
+		favorites[song.id] = favorite
+		scope.launch {
