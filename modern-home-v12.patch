+
+		return content {
+			ModernMusicItemScreen(viewModel = viewModel)
+		}
+	}
+
+	override fun onResume() {
+		super.onResume()
+
+		// Playlists change after "Add to playlist", favorites on other pages
+		if (!firstResume) viewModel.refresh()
+		firstResume = false
+	}
+}
