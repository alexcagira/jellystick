<?xml version="1.0" encoding="utf-8"?>
<!-- Cell of the TV guide (programme or channel): a dark rounded card with a thin glass border -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="2dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/guide_cell_bg" />
        <stroke
            android:width="1dp"
            android:color="@color/guide_cell_border" />
        <corners android:radius="7dp" />
    </shape>
</inset>
